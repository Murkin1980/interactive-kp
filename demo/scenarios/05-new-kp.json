{
  "$schema": "../../node_modules/testreel/recording-definition.schema.json",
  "url": "https://kp.salamat-mebel.kz/proposals/new",
  "viewport": { "width": 1440, "height": 900 },
  "outputSize": { "width": 1920, "height": 1080 },
  "outputFormat": "webm",
  "speed": 0.7,
  "storageState": "C:\\tmp\\interactive-kp-demo-auth.json",
  "cursor": { "style": "pointer", "size": 36, "rippleColor": "rgba(194, 164, 109, 0.5)", "idleHide": false },
  "chrome": { "enabled": true, "titleBarColor": "#14263D", "url": "kp.salamat-mebel.kz/proposals/new" },
  "background": { "color": "#F3EFE4", "padding": 40, "borderRadius": 12 },
  "steps": [
    { "action": "wait", "ms": 3000 },
    { "action": "screenshot", "name": "new-kp-form" },
    { "action": "wait", "ms": 1500 },
    { "action": "click", "selector": "#client_id" },
    { "action": "wait", "ms": 500 },
    { "action": "select", "selector": "#client_id", "value": "0" },
    { "action": "wait", "ms": 1500 },
    { "action": "click", "selector": "#project_name" },
    { "action": "wait", "ms": 500 },
    { "action": "type", "selector": "#project_name", "text": "Кухня Neo Deco", "delay": 60 },
    { "action": "wait", "ms": 1000 },
    { "action": "click", "selector": "input[type='date']" },
    { "action": "wait", "ms": 500 },
    { "action": "fill", "selector": "input[type='date']", "text": "2026-08-30" },
    { "action": "wait", "ms": 1000 },
    { "action": "click", "selector": "input[type='number']" },
    { "action": "wait", "ms": 500 },
    { "action": "fill", "selector": "input[type='number']", "text": "50" },
    { "action": "wait", "ms": 1500 },
    { "action": "screenshot", "name": "form-filled" },
    { "action": "wait", "ms": 1000 },
    { "action": "click", "selector": "button:has-text('Создать КП')" },
    { "action": "wait", "ms": 4000 },
    { "action": "screenshot", "name": "kp-created" }
  ]
}
